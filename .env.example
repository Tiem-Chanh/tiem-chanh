# Copy to .env, set your own password, then run: node --env-file=.env server.mjs
ADMIN_USER=owner
# Required to enable admin; 12 to 256 characters. No default password.
ADMIN_PASSWORD=
HOST=127.0.0.1
PORT=3000
# Set when deploying behind HTTPS, without a trailing slash.
# PUBLIC_ORIGIN=https://example.com
# DATA_DIR=/absolute/path/to/persistent-data
